# ---------------------------------------------------------------------------
# InstaPlay environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Supabase project credentials.
# For GitHub Pages deployment, add the SAME values as repository secrets
# named SUPABASE_URL and SUPABASE_ANON_KEY (see .github/workflows/deploy.yml).
#
# NOTE: The Supabase anon key is designed to be public and safe to ship in a
# static bundle. Data is protected by Row Level Security (RLS), not the key.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: override the default title shown in the UI
# VITE_SITE_TITLE=InstaPlay
